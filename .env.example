# GESA platform — environment variables
# Copy to .env.local for local dev. Never commit real secrets.
# Each environment (Dev / UAT / Production) gets its own Supabase project
# and its own copy of these values, set in Vercel's per-environment env vars.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, NEVER prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (server-only) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="GESA <no-reply@gesa.org>"
# Phase 177 — where every admin/team notification (contact form, Find
# Support requests, bookings, volunteer applications, donations, group
# registrations) actually gets sent. Must be a real, valid, monitored email
# address — see lib/email/resend.ts's getContactInbox() for what happens if
# this is missing or malformed (falls back to a temporary default and warns
# on the admin dashboard, it does NOT silently use a placeholder).
GESA_CONTACT_INBOX=gesa.org26@gmail.com

# --- Public contact email (safe to expose to the browser) ---
# The address shown to visitors (Contact page, footer). Optional — defaults
# to the same address as GESA_CONTACT_INBOX above (lib/contact.ts) if unset;
# only set this if the publicly displayed address should ever differ from
# where notifications are actually delivered.
NEXT_PUBLIC_GESA_CONTACT_EMAIL=gesa.org26@gmail.com

# --- Google Cloud Translation (server-only) — powers the site-wide
# English/Hebrew language switcher (Phase 10, narrowed to two languages in
# Phase 33). Without this, the page still flips direction for Hebrew but the
# text itself stays in English. Get one from console.cloud.google.com: turn
# on the "Cloud Translation API" on a billing-enabled project, then create an
# API key. ---
GOOGLE_TRANSLATE_API_KEY=

# --- Anthropic (server-only) — powers real AI therapist matching in the
# Find Your Therapist wizard (Phase 9). Falls back to a rule-based matcher
# if left blank, so this is optional but recommended. ---
ANTHROPIC_API_KEY=

# --- Mollie (server-only) — powers real payment checkout on the /donate
# page (Phase 99). Sign up at mollie.com, then grab the API key from your
# dashboard's Developers > API keys screen. Use the "test" key (starts with
# test_) while trying this out — nothing charges real money in test mode,
# and payments show up in the Mollie dashboard's test-mode view. Switch to
# the "live" key (starts with live_) only once you're ready to accept real
# donations; you'll need to activate payment methods for your account first
# (Mollie walks you through this on signup). Leaving this blank makes the
# /donate page's "Continue to payment" button show a clear error instead of
# crashing. ---
MOLLIE_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
